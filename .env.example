# Copy to .env and fill in. .env is git-ignored: never commit the real values.

# development (default) or production. Production turns off /dev pages and warns about unsafe settings.
ENV=development

# Neon connection string (Neon console -> Connect). Leave empty to use a local SQLite file.
DATABASE_URL=

# Where the server listens. Use 0.0.0.0 in a container.
HOST=127.0.0.1
PORT=8000

# The public address of this server, e.g. https://forecast.example.com (needed for sign-in and Claude).
PUBLIC_BASE_URL=

# Extra host names allowed to reach /mcp (e.g. a tunnel), comma-separated. PUBLIC_BASE_URL's host is added automatically.
ALLOWED_HOSTS=

# ---- Sign-in -------------------------------------------------------------
# none = one local user, no login (development only). oidc = sign in through an OpenID Connect provider.
AUTH_MODE=none
# The provider's issuer URL (must support Dynamic Client Registration or Client ID Metadata Documents for Claude).
OIDC_ISSUER=
# An app you register at the provider for the dashboard login. Redirect URI: <PUBLIC_BASE_URL>/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Expected `aud` of access tokens Claude sends to /mcp, usually <PUBLIC_BASE_URL>/mcp. Leave empty only with a dedicated issuer.
MCP_AUDIENCE=
MCP_REQUIRED_SCOPES=
# Random string (at least 32 characters) that signs the dashboard session cookie.
SESSION_SECRET=

# Used when AUTH_MODE=none.
DEFAULT_ACTOR=planner@local
DEFAULT_WORKSPACE=demo

# ---- Public operation ----------------------------------------------------
CONTACT_EMAIL=
RATE_LIMIT_PER_MINUTE=120
MAX_WHAT_IFS_PER_EVENT=30
MAX_PENDING_PER_EVENT=50
# Development pages (/dev/panel). Defaults to 1 in development, 0 in production.
# DEV_ROUTES=1

# ---- Small / free hosting -------------------------------------------------
# light = smaller forecast ensemble and shorter optimizer search, for hosts with a fraction of a CPU.
ENGINE_PROFILE=standard
# How often an idle worker checks the database (seconds). Long, so Neon can scale to zero.
WORKER_IDLE_POLL_SECONDS=600
# Set to 0 if your sign-in provider rejects PKCE for confidential (client-secret) apps.
OIDC_PKCE=1
